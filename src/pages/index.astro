---
import '../styles/global.css';
import LineIcon from '../components/LineIcon.astro';

const services = [
  {
    number: '01',
    label: 'Website project',
    icon: 'website',
    title: 'Build your website',
    copy: 'A custom artist site built around releases, shows, merch, biography, and the actions you want fans to take.',
    details: ['Strategy and design', 'Responsive development', 'Music, shows, merch, and fan links'],
  },
  {
    number: '02',
    label: 'Connected as needed',
    icon: 'connect',
    title: 'Connect your platforms',
    copy: 'Bring music, show dates, stores, email, and related accounts into a clearer experience where those services support it.',
    details: ['Existing stores welcome', 'Supported music and show connections', 'Branded email and account setup'],
  },
  {
    number: '03',
    label: 'Optional ongoing support',
    icon: 'maintain',
    title: 'Keep it running',
    copy: 'Get practical help with domains, hosting, content updates, search foundations, structured data, and technical upkeep.',
    details: ['Domain and hosting support', 'Updates and maintenance', 'Search and site structure'],
  },
] as const;

const benefits = [
  ['home', 'A professional home', 'Give the music a lasting, artist-owned destination beyond a feed or release campaign.'],
  ['refresh', 'Less catalog upkeep', 'Reduce repeated updates when supported music sources and practical workflows can do part of the work.'],
  ['share', 'Release links to share', 'Send fans to one release page on the artist’s own domain, with reviewed platform destinations.'],
  ['organize', 'Fewer loose ends', 'Keep domains, accounts, stores, and website details easier for the artist and team to understand.'],
] as const;

const process = [
  ['01', 'plan', 'Plan', 'Review the artist’s goals, existing domain, website, accounts, music sources, store, and team.'],
  ['02', 'build', 'Build', 'Create the site and connect the services that make sense for that artist—not a one-size-fits-all stack.'],
  ['03', 'support', 'Maintain', 'Launch, document the setup, and provide ongoing technical support if requested.'],
] as const;

const work = [
  {
    index: '01', name: 'Morbeato', url: 'https://morbeato.com', displayUrl: 'morbeato.com', category: 'Artist website', className: 'work-card--morbeato', marks: ['LIVE', 'MUSIC', 'MERCH'],
    builtFor: 'A heavy dubstep artist with releases, live dates, merch, and a distinct visual identity.',
    handled: 'A searchable catalog with release-type filters, EDMTrain show dates and tickets, a merch-ready section, and photo gallery.',
  },
  {
    index: '02', name: 'Dezolent', url: 'https://dezolent.com', displayUrl: 'dezolent.com', category: 'Artist website', className: 'work-card--dezolent', marks: ['ARTIST', 'CATALOG', 'IDENTITY'],
    builtFor: 'A producer catalog spanning tracks, albums, collaborations, and editorial content.',
    handled: 'A searchable catalog with genre and type filters, track and album pages, release fan links, and a Sanity-backed journal.',
  },
  {
    index: '03', name: 'Coptr', url: 'https://coptr.me', displayUrl: 'coptr.me', category: 'Artist website', className: 'work-card--coptr', marks: ['MUSIC', 'EPK', 'FANLINKS'],
    builtFor: 'A Miami producer and DJ balancing new music, artist story, and professional context.',
    handled: 'Homepage, latest releases, biography and contact, plus dedicated EPK and fan-link routes.',
  },
];

const title = 'Bounced — Artist Websites & Digital Operations';
const description = 'Bounced builds and maintains artist websites that bring music, shows, merch, and fan links into one professional home.';
const canonical = 'https://bounced.studio/';
const socialImage = 'https://bounced.studio/bounced-og.png';
const logo = 'https://bounced.studio/bounced-logo.png';
const email = 'artists@bounced.studio';
const inquiryHref = `mailto:${email}?subject=Bounced%20project%20inquiry&body=Artist%20or%20project%20name%3A%0AWebsite%20or%20artist%20link%3A%0A%0AWhat%20would%20you%20like%20help%20with%3F%0A%0AOptional%20timeline%3A%0A`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${canonical}#organization`, name: 'Bounced', url: canonical, email, logo, image: socialImage, parentOrganization: { '@type': 'Organization', name: 'Dezolent, LLC' } },
    { '@type': 'WebSite', '@id': `${canonical}#website`, url: canonical, name: 'Bounced', image: socialImage, publisher: { '@id': `${canonical}#organization` } },
    { '@type': 'Service', name: 'Artist website development and digital operations', provider: { '@id': `${canonical}#organization` }, description, url: canonical },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#07090c" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bounced" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bounced — artist websites and digital operations" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Bounced — artist websites and digital operations" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="Bounced home">
        <img src="/bounced-wordmark-light-blue.png" alt="Bounced" width="1500" height="300" />
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="#services">Services</a><a href="#process">Process</a><a href="#work">Work</a><a href="#contact">Contact</a>
      </nav>
      <a class="header-cta" href="#contact">Start a project <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu">
        <summary>Menu</summary>
        <nav aria-label="Mobile navigation">
          <a href="#services">Services</a><a href="#process">Process</a><a href="#work">Work</a><a href="#contact">Contact</a>
        </nav>
      </details>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-noise" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="eyebrow reveal reveal--1"><span>Website & digital operations by Bounced</span><span>Operated by Dezolent, LLC</span></p>
          <h1 id="hero-title" class="reveal reveal--2">Artist websites built for the music—<br /><em>and kept in sync with everything around it.</em></h1>
          <div class="hero-bottom reveal reveal--3">
            <p class="hero-intro">Bounced builds and maintains artist websites that bring music, shows, merch, and fan links into one home. We handle the technical details that keep that home running.</p>
            <div class="hero-actions">
              <a class="button button--primary" href="#contact">Tell us about your project <span aria-hidden="true">↗</span></a>
              <a class="button button--text" href="#work">View our work <span aria-hidden="true">↓</span></a>
            </div>
          </div>
        </div>

        <div class="system-map reveal reveal--4" aria-label="Diagram showing an artist website connected to music, shows, commerce, and digital accounts">
          <div class="map-meta"><span>BOUNCED / SYSTEM MAP</span><span>ONLINE PRESENCE</span></div>
          <div class="map-field">
            <div class="signal signal--vertical" aria-hidden="true"></div><div class="signal signal--horizontal" aria-hidden="true"></div>
            <div class="map-node map-node--center"><span class="node-light" aria-hidden="true"></span><strong>Artist website</strong><small>The home base</small></div>
            <div class="map-node map-node--music"><span>01</span> Music</div><div class="map-node map-node--shows"><span>02</span> Shows</div>
            <div class="map-node map-node--commerce"><span>03</span> Commerce</div><div class="map-node map-node--accounts"><span>04</span> Accounts</div>
          </div>
          <div class="map-footer"><span>Build what people see.</span><span>Support what keeps it running.</span></div>
        </div>
        <div class="hero-rail" aria-hidden="true"><span>WEB</span><i></i><span>OPS</span><i></i><span>DATA</span><i></i><span>SYSTEMS</span></div>
      </section>

      <section class="services section" id="services" aria-labelledby="services-title">
        <div class="section-heading">
          <p class="kicker">01 / Services</p>
          <div><h2 id="services-title">One artist website.<br /><span>Three ways we help.</span></h2><p>Start with a website project. Add platform connections and ongoing support only where they fit your setup.</p></div>
        </div>
        <div class="service-grid" aria-label="Core offer">
          {services.map((service) => (
            <article class="service-card">
              <div class="service-card__meta"><span>{service.number}</span><span>{service.label}</span></div>
              <LineIcon name={service.icon} />
              <h3>{service.title}</h3>
              <p>{service.copy}</p>
              <ul>{service.details.map((detail) => <li>{detail}</li>)}</ul>
            </article>
          ))}
        </div>
        <div class="capabilities" aria-labelledby="capabilities-title">
          <div class="capabilities-heading">
            <p class="kicker">What that can include</p>
            <h3 id="capabilities-title">Useful systems behind the website.</h3>
            <p>These capabilities are scoped around the artist’s sources, access, and the services each platform supports.</p>
          </div>
          <div class="capability-grid">
            <article class="capability-card capability-card--catalog">
              <div class="capability-card__top"><LineIcon name="catalog" /><span>Music catalog</span></div>
              <h4>A catalog that stays useful as the music grows.</h4>
              <p>Supported Spotify and SoundCloud data can be used as catalog inputs, with releases reviewed before they are published. Fans can then search and browse the music in ways that fit the catalog.</p>
              <div class="example-list">
                <a href="https://dezolent.com/tracks" target="_blank" rel="noopener noreferrer" aria-label="Explore Dezolent’s searchable catalog (opens in a new tab)">
                  <span><strong>Dezolent</strong><small>Search by title; filter by genre and by collaborations, originals, remixes, or solo tracks.</small></span><span aria-hidden="true">↗</span>
                </a>
                <a href="https://morbeato.com/music/" target="_blank" rel="noopener noreferrer" aria-label="Explore Morbeato’s music catalog (opens in a new tab)">
                  <span><strong>Morbeato</strong><small>Search by title or artist; filter by originals, collaborations, or remixes.</small></span><span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
            <article class="capability-card">
              <div class="capability-card__top"><LineIcon name="fanlink" /><span>Release fan links</span></div>
              <h4>One release link, on the artist’s domain.</h4>
              <p>A release record can generate its own route with reviewed destinations for the listening platforms where that release is available. Platform URLs still receive manual review and correction; availability is not assumed.</p>
              <a class="capability-action" href="https://dezolent.com/stream/gone-coptr-remix" target="_blank" rel="noopener noreferrer" aria-label="View a fan link example (opens in a new tab)"><span>View a fan link example</span><span aria-hidden="true">↗</span></a>
            </article>
            <article class="capability-card">
              <div class="capability-card__top"><LineIcon name="report" /><span>Private catalog review</span></div>
              <h4>MLC musical-work review, with human follow-up.</h4>
              <p>Where source access and coverage permit, Bounced can compare an artist’s Spotify recordings with The MLC’s musical-work records and produce a private recording-to-work report for the artist or team.</p>
              <p class="capability-note">Possible gaps are flags for human review—not proof of ownership, missing royalties, or an unmatched recording. The report does not resolve registrations or guarantee collection.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="benefits section" id="benefits" aria-labelledby="benefits-title">
        <div class="benefit-statement">
          <p class="kicker kicker--light">02 / Why Bounced</p>
          <h2 id="benefits-title">One clear home.<br /><em>Less digital drag.</em></h2>
          <p class="benefit-lead">The result is a professional home for the work and a technical setup that is easier for the artist and team to manage.</p>
        </div>
        <div class="benefit-grid">
          {benefits.map(([icon, benefitTitle, copy], index) => <article class="benefit-item"><div class="benefit-item__top"><span>0{index + 1}</span><LineIcon name={icon} inverse /></div><h3>{benefitTitle}</h3><p>{copy}</p></article>)}
        </div>
      </section>

      <section class="process section" id="process" aria-labelledby="process-title">
        <div class="process-heading">
          <div><p class="kicker">03 / How we work</p><h2 id="process-title">A clear path from<br /><span>setup to launch.</span></h2></div>
          <p>Bounced can work directly with an artist or alongside an existing manager, label team, designer, or other partner.</p>
        </div>
        <ol class="process-list">
          {process.map(([number, icon, stepTitle, copy]) => <li><div class="process-card__top"><span>{number}</span><LineIcon name={icon} /></div><div><h3>{stepTitle}</h3><p>{copy}</p></div></li>)}
        </ol>
        <aside class="ownership-note"><strong>Your accounts stay yours.</strong><p>We can work with your existing domain, Google Workspace or other email provider, and current store. A provider change is recommended only when it solves a real problem.</p></aside>
      </section>

      <section class="work section" id="work" aria-labelledby="work-title">
        <div class="work-heading"><div><p class="kicker">04 / Selected work</p><h2 id="work-title">Built around<br /><span>the artist.</span></h2></div><p>Three artist websites, each shaped around different music, content, and fan journeys.</p></div>
        <div class="work-grid">
          {work.map((project) => (
            <a id={`work-${project.name.toLowerCase()}`} class:list={['work-card', project.className]} href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${project.name} at ${project.displayUrl} (opens in a new tab)`}>
              <div class="work-card__top"><span>{project.index}</span><span>{project.category}</span><span aria-hidden="true">↗</span></div>
              <div class="work-visual" aria-hidden="true"><div class="work-wordmark">{project.name}</div><div class="work-marks">{project.marks.map((mark) => <span>{mark}</span>)}</div></div>
              <div class="work-card__bottom"><div><span>Built for</span><p>{project.builtFor}</p></div><div><span>What we handled</span><p>{project.handled}</p></div><strong>{project.displayUrl} ↗</strong></div>
            </a>
          ))}
        </div>
      </section>

      <section class="artistops section" id="artistops" aria-labelledby="artistops-title">
        <div class="artistops-labels"><div class="development-label"><span></span> In development</div><p class="kicker">05 / What we’re building next</p></div>
        <div class="artistops-copy"><h2 id="artistops-title">A connected view of artist operations.</h2><p>ArtistOps is an early dashboard concept for bringing shows, releases, website traffic, merch, and other artist data into one useful view. It is not a live product; Bounced’s available work today is website development and digital operations support.</p></div>
      </section>

      <section class="contact section" id="contact" aria-labelledby="contact-title">
        <p class="kicker kicker--light">06 / Start a conversation</p>
        <div class="contact-grid">
          <h2 id="contact-title">Tell us what you’re<br /><em>working on.</em></h2>
          <div class="contact-copy">
            <p>Share the artist or project, a link if you have one, what you need help with, and any timing we should know. We’ll reply by email.</p>
            <a class="contact-email" href={inquiryHref}><span>Start an email</span><span aria-hidden="true">↗</span></a>
            <div class="email-alternative"><span>Or email</span><a href={`mailto:${email}`}>{email}</a><button class="copy-email" type="button" data-email={email}>Copy</button></div>
            <p class="copy-status" role="status" aria-live="polite"></p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-brand"><img src="/bounced-wordmark-white.png" alt="Bounced" width="1500" height="300" loading="lazy" /><p>Bounced · operated by Dezolent, LLC.</p></div>
      <nav aria-label="Footer navigation"><a href="#services">Services</a><a href="#process">Process</a><a href="#work">Work</a><a href="https://app.bounced.studio/privacy">Privacy</a><a href="https://app.bounced.studio/terms">Terms</a><a href="#top">Back to top ↑</a></nav>
      <p class="copyright">© {new Date().getFullYear()} Dezolent, LLC</p>
    </footer>

    <script>
      const copyButton = document.querySelector<HTMLButtonElement>('.copy-email');
      const copyStatus = document.querySelector<HTMLElement>('.copy-status');

      copyButton?.addEventListener('click', async () => {
        const address = copyButton.dataset.email ?? '';
        try {
          await navigator.clipboard.writeText(address);
          copyButton.textContent = 'Copied';
          if (copyStatus) copyStatus.textContent = `${address} copied to clipboard.`;
        } catch {
          if (copyStatus) copyStatus.textContent = `Copy unavailable. Email us at ${address}.`;
        }
      });

      document.querySelectorAll<HTMLAnchorElement>('.mobile-menu a').forEach((link) => {
        link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
      });
    </script>
  </body>
</html>
