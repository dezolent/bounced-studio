---
type IconName =
  | 'website'
  | 'connect'
  | 'maintain'
  | 'catalog'
  | 'fanlink'
  | 'report'
  | 'home'
  | 'refresh'
  | 'share'
  | 'organize'
  | 'plan'
  | 'build'
  | 'support';

interface Props {
  name: IconName;
  inverse?: boolean;
}

const { name, inverse = false } = Astro.props;
---

<span class:list={['line-icon', { 'line-icon--inverse': inverse }]} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {name === 'website' && <><rect x="2.75" y="4" width="18.5" height="16" rx="1.5" /><path d="M3 8h18M6.5 6h.01M9 6h.01M7 12h6M7 15h10" /></>}
    {name === 'connect' && <><circle cx="5" cy="6" r="2.25" /><circle cx="19" cy="6" r="2.25" /><circle cx="12" cy="18" r="2.25" /><path d="m7 7.2 3.2 8M17 7.2l-3.2 8M7.3 6h9.4" /></>}
    {name === 'maintain' && <><circle cx="12" cy="12" r="3" /><path d="M12 2.75v3M12 18.25v3M21.25 12h-3M5.75 12h-3M18.55 5.45l-2.1 2.1M7.55 16.45l-2.1 2.1M18.55 18.55l-2.1-2.1M7.55 7.55l-2.1-2.1" /></>}
    {name === 'catalog' && <><circle cx="9.5" cy="10" r="5.75" /><circle cx="9.5" cy="10" r="1.5" /><path d="m13.7 14.2 3.9 3.9M17.8 14.4v5.1M17.8 14.4l3-1" /></>}
    {name === 'fanlink' && <><path d="m9.3 14.7-1.6 1.6a3.25 3.25 0 0 1-4.6-4.6l3.1-3.1a3.25 3.25 0 0 1 4.6 0M14.7 9.3l1.6-1.6a3.25 3.25 0 1 1 4.6 4.6l-3.1 3.1a3.25 3.25 0 0 1-4.6 0M8.5 15.5l7-7" /></>}
    {name === 'report' && <><path d="M6 2.75h8l4 4V21.25H6zM14 2.75v4h4M8.8 12.3l2 2 4.5-4.5M9 18h6" /></>}
    {name === 'home' && <><path d="m3 11 9-7.5 9 7.5M5.5 9.2v11h13v-11M9 20v-6h6v6" /></>}
    {name === 'refresh' && <><path d="M20 7.5V3.8l-2 2A8 8 0 1 0 19.2 16M4 16.5v3.7l2-2" /></>}
    {name === 'share' && <><circle cx="5" cy="12" r="2.25" /><circle cx="19" cy="6" r="2.25" /><circle cx="19" cy="18" r="2.25" /><path d="m7.1 11 9.8-4M7.1 13l9.8 4" /></>}
    {name === 'organize' && <><path d="M4 6h16M4 12h16M4 18h16" /><circle cx="8" cy="6" r="1.75" fill="currentColor" stroke="none" /><circle cx="16" cy="12" r="1.75" fill="currentColor" stroke="none" /><circle cx="10" cy="18" r="1.75" fill="currentColor" stroke="none" /></>}
    {name === 'plan' && <><circle cx="12" cy="12" r="8.5" /><path d="m15.5 8.5-2.1 4.9-4.9 2.1 2.1-4.9z" /></>}
    {name === 'build' && <><path d="m12 3 9 4.5-9 4.5-9-4.5zM3 12l9 4.5 9-4.5M3 16.5l9 4.5 9-4.5" /></>}
    {name === 'support' && <><circle cx="12" cy="12" r="8.5" /><circle cx="12" cy="12" r="3.25" /><path d="m6 6 3.7 3.7M18 6l-3.7 3.7M6 18l3.7-3.7M18 18l-3.7-3.7" /></>}
  </svg>
</span>

<style>
  .line-icon { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid rgba(62,181,238,.38); background: rgba(62,181,238,.08); color: #93dcff; }
  .line-icon svg { width: 24px; height: 24px; }
  .line-icon--inverse { border-color: rgba(6,16,21,.34); background: rgba(6,16,21,.07); color: #061015; }
  @media (max-width: 760px) { .line-icon { width: 44px; height: 44px; } }
</style>
